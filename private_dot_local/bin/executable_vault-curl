#!/usr/bin/env bash
# vault-curl — curl wrapper for the vault-storage REST API (Obsidian-compatible).
#
# Prepends the Authorization header and the vault base URL to the given path,
# then passes the remaining options through to curl. All flags are curl's.
#
# Usage:
#   vault-curl <path> [curl-options...]
#
# The path is appended to $PROGRAM_CLERK_URL. A leading "/" is optional.
#
# Examples:
#   vault-curl /vault/_index.md
#   vault-curl /vault/logs/ -s
#   vault-curl /vault/topics/foo.md -X PUT -H 'Content-Type: text/markdown' --data-binary @foo.md
#   vault-curl /search/simple/ -X POST -H 'Content-Type: application/json' -d '{"query":"docker"}'
#
# Environment (the old VAULT_API_URL and VAULT_API_TOKEN are read when these are unset):
#   PROGRAM_CLERK_URL — base URL of the server
#   PROGRAM_CLERK_KEY — bearer token

set -uCo pipefail

# Hard dependency. Inline (no bootstrap.sh source — vault-curl stays slim
# so it's cheap to invoke from scripts, hooks, or one-liners).
if ! command -v curl >/dev/null 2>&1; then
  echo "vault-curl: curl is required but is not installed" >&2
  exit 1
fi

url=${PROGRAM_CLERK_URL:-${VAULT_API_URL:-}}
key=${PROGRAM_CLERK_KEY:-${VAULT_API_TOKEN:-}}
missing=()
[[ -n $url ]] || missing+=(PROGRAM_CLERK_URL)
[[ -n $key ]] || missing+=(PROGRAM_CLERK_KEY)
if ((${#missing[@]})); then
  names=${missing[*]}
  echo "vault-curl: set ${names// / and } (or the old VAULT_API_URL and VAULT_API_TOKEN)" >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "usage: vault-curl <path> [curl-options...]" >&2
  exit 1
fi

path=$1
shift

# Normalize: strip trailing slash from base, ensure leading slash on path.
base=${url%/}
[[ $path == /* ]] || path=/$path

# Fail fast instead of hanging when the server stops answering. Defaults sit
# before "$@" so any caller can override per-call (--max-time 600 for a big
# reindex) or via VAULT_CURL_MAX_TIME.
exec curl --connect-timeout 5 --max-time "${VAULT_CURL_MAX_TIME:-120}" \
  -H "Authorization: Bearer $key" "$@" "$base$path"
