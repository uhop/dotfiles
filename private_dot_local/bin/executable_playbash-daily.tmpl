#!/usr/bin/env bash
# playbash-daily — daily maintenance stack: chezmoi update,
# claude-config-update, fleet-status (croc only), dcms, then upd -ry. Each
# step runs as an isolated playbash_section so one failure doesn't abort the
# rest; the final playbash_section_report propagates non-zero exit if any
# section failed.

set -euCo pipefail
shopt -s expand_aliases

source "${PLAYBASH_LIBS:-$HOME/.local/libs}/playbash.sh"

playbash_section chezmoi       chezmoi update
playbash_section claude-config claude-config-update

{{ if eq .chezmoi.hostname "croc" -}}
# GitHub-side fleet state (claude-config's fleet-status skill, on $PATH via the
# shim): collect every public repository, then commit the run — the baselines
# in the vault's projects/<name>/state.md and the fleet digest — so a later
# `/fleet-status show --fleet` reads the movement from the vault. One host
# only: a second collection the same day finds what the first consumed. Runs
# after claude-config-update so the script is current; needs the vault env
# (~/.env) and a gh login in the invoking shell, and fails as a section, never
# silently, without them. Manual cadence by ruling (2026-09-05): no cron.
playbash_section fleet-status  sh -c 'F=$(mktemp) && fleet-status collect --fleet --out "$F" && fleet-status commit "$F"; rc=$?; rm -f "$F"; exit $rc'

{{ end -}}
# Skip the Docker-stack refresh when the daemon is unreachable (e.g. macOS
# with Docker Desktop stopped — it starts on demand). `dcms` self-guards
# too, but gating the section here keeps the playbook from logging a
# section for a guaranteed no-op. `docker info` is also non-zero when
# docker isn't installed at all, so this covers docker-less hosts as well.
if docker info &> /dev/null; then
  playbash_section services    dcms daily
fi

playbash_section system        upd -ry

playbash_section_report
