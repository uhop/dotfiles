#!/usr/bin/env bash
# vault-curl — curl wrapper for the vault-storage REST API (Obsidian-compatible).
#
# Prepends the Authorization header and the vault base URL to the given path,
# then passes the remaining options through to curl. All flags are curl's.
#
# Usage:
#   vault-curl <path> [curl-options...]
#
# The path is appended to $PROGRAM_CLERK_URL. A leading "/" is optional.
#
# A 429 that names its Retry-After (the pool's limit on an account's rate,
# vault-storage 7z) applied nothing, so the request is sent again after that
# wait, for five minutes in all. An outage is waited out too (vault-storage
# 7as-2, D751): a connection never made, or a 503 that applied nothing (one
# naming tenant_unavailable, verification_unavailable, or writes_paused, or
# the balancer's own, which is not JSON), is sent again whatever the method; a
# read also after a 502, a 503, a 504, a timeout, or a dropped connection. The
# waits grow from 250 ms to 16 s, each at least the answer's Retry-After, for
# 90 s from the first failure (VAULT_CURL_OUTAGE_S), under an agent's 120 s
# command limit (question 430). The first failure marks the outage in a file,
# so a call that starts while it is marked tries once until one gets another
# answer, and only an outage's first call waits. Each
# try's output is held until it is the last. A request that reads stdin, or
# names its own -D, goes once.
#
# Examples:
#   vault-curl /vault/_index.md
#   vault-curl /vault/logs/ -s
#   vault-curl /vault/topics/foo.md -X PUT -H 'Content-Type: text/markdown' --data-binary @foo.md
#   vault-curl /search/simple/ -X POST -H 'Content-Type: application/json' -d '{"query":"docker"}'
#
# Environment (the old VAULT_API_URL and VAULT_API_TOKEN are read when these are unset):
#   PROGRAM_CLERK_URL — base URL of the server
#   PROGRAM_CLERK_KEY — bearer token
#   VAULT_CURL_OUTAGE_S — how long an outage is waited out, in seconds (90)

set -uCo pipefail

# Hard dependency. Inline (no bootstrap.sh source — vault-curl stays slim
# so it's cheap to invoke from scripts, hooks, or one-liners).
if ! command -v curl >/dev/null 2>&1; then
  echo "vault-curl: curl is required but is not installed" >&2
  exit 1
fi

url=${PROGRAM_CLERK_URL:-${VAULT_API_URL:-}}
key=${PROGRAM_CLERK_KEY:-${VAULT_API_TOKEN:-}}
missing=()
[[ -n $url ]] || missing+=(PROGRAM_CLERK_URL)
[[ -n $key ]] || missing+=(PROGRAM_CLERK_KEY)
if ((${#missing[@]})); then
  names=${missing[*]}
  echo "vault-curl: set ${names// / and } (or the old VAULT_API_URL and VAULT_API_TOKEN)" >&2
  exit 1
fi

if [ $# -lt 1 ]; then
  echo "usage: vault-curl <path> [curl-options...]" >&2
  exit 1
fi

path=$1
shift

# Normalize: strip trailing slash from base, ensure leading slash on path.
base=${url%/}
[[ $path == /* ]] || path=/$path

# Fail fast instead of hanging when the server stops answering. Defaults sit
# before "$@" so any caller can override per-call (--max-time 600 for a big
# reindex) or via VAULT_CURL_MAX_TIME.
send=(curl --connect-timeout 5 --max-time "${VAULT_CURL_MAX_TIME:-120}"
  -H "Authorization: Bearer $key")

# Stdin is read once, so a request that reads it is never sent again. A request
# that sends no body and names no method but GET or HEAD only reads.
read_only=1
prev=
for arg in "$@"; do
  case $arg in
    *@- | *@/dev/stdin | -T- | -K-) exec "${send[@]}" "$@" "$base$path" ;;
    -d | --data | --data-* | -F | --form | -T | --upload-file) read_only=0 ;;
  esac
  if [[ $arg =~ ^(-|/dev/stdin)$ && $prev =~ ^(-T|--upload-file|-K|--config)$ ]]; then
    exec "${send[@]}" "$@" "$base$path"
  fi
  if [[ ($prev == -X || $prev == --request) && ! $arg =~ ^(GET|HEAD)$ ]]; then read_only=0; fi
  prev=$arg
done

work=$(mktemp -d) || exit 1
trap 'rm -rf -- "$work"' EXIT
outage=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/vault-curl-outage-$UID
outage_s=${VAULT_CURL_OUTAGE_S:-90}
steps=(250 500 1000 2000 4000 8000 16000)
waited=0
first=
step=0
while :; do
  # A try that fails before any answer writes no headers, so none of the last try's are read.
  rm -f -- "${work:?}/head"
  # Our -D sits before "$@": a caller's own wins, and with no headers to read its request goes once.
  "${send[@]}" -D "$work/head" "$@" "$base$path" >|"$work/out" 2>|"$work/err"
  code=$?
  status=
  after=
  type=
  if [[ -s $work/head ]]; then
    # The last block's: a 100 Continue or a redirect comes before the final answer.
    read -r status after type < <(awk '/^HTTP\//{s=$2; a="-"; t="-"}
      tolower($1)=="retry-after:"{a=$2} tolower($1)=="content-type:"{t=$2}
      END{sub(/\r$/, "", a); sub(/\r$/, "", t); sub(/;$/, "", t); print s, a, t}' "$work/head")
    [[ $after != - ]] || after=
  fi
  left=$((300 - waited))
  if [[ $status == 429 && $after =~ ^[1-9][0-9]*$ ]] && ((left > 0)); then
    ((after < left)) || after=$left
    sleep "$after"
    ((waited += after))
    continue
  fi
  repeat=0
  if ((code == 7)); then
    repeat=1
  elif [[ $status == 503 ]] && { [[ $type != application/*json ]] ||
    grep -Eq '"code" *: *"(tenant_unavailable|verification_unavailable|writes_paused)"' "$work/out"; }; then
    repeat=1
  elif ((read_only)) && [[ $code =~ ^(28|52|55|56)$ || $status =~ ^50[234]$ ]]; then
    repeat=1
  fi
  if ((repeat)) && [[ -n $first || ! -e $outage ]]; then
    if [[ -z $first ]]; then
      first=$SECONDS
      : >|"$outage"
    fi
    left=$((outage_s - (SECONDS - first)))
    if ((left > 0)); then
      ms=${steps[step < ${#steps[@]} ? step : ${#steps[@]} - 1]}
      [[ ! $after =~ ^[1-9][0-9]*$ ]] || ((after * 1000 <= ms)) || ms=$((after * 1000))
      ((ms <= left * 1000)) || ms=$((left * 1000))
      sleep "$((ms / 1000)).$(printf '%03d' $((ms % 1000)))"
      ((++step))
      continue
    fi
  elif ((!repeat)) && [[ -n $status ]]; then
    rm -f -- "$outage"
  fi
  cat -- "$work/out"
  cat -- "$work/err" >&2
  exit "$code"
done
