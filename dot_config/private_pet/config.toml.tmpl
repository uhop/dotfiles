{{- /* The gist id stays out of the repository: PET_GIST_ID from ~/.env, else this host's current value. */ -}}
{{- $gistId := env "PET_GIST_ID" -}}
{{- $current := joinPath .chezmoi.homeDir ".config/pet/config.toml" -}}
{{- if and (not $gistId) (stat $current) -}}
{{-   $gistId = include $current | regexFind "\\[Gist\\][^\\[]*gist_id = \"[0-9a-f]+\"" | regexFind "[0-9a-f]{20,}" -}}
{{- end }}
[GHEGist]
  Public = false
  access_token = ""
  auto_sync = false
  base_url = ""
  file_name = ""
  gist_id = ""
  upload_url = ""

[General]
  Backend = "gist"
  Cmd = []
  Color = false
  Column = 40
  Editor = "micro"
  Format = "[$description]: $command $tags"
  SelectCmd = "fzf --ansi --layout=reverse --border --height=90% --pointer=* --cycle --prompt=Snippets:"
  SnippetDirs = []
  SnippetFile = "~/.config/pet/snippet.toml"
  SortBy = ""

[Gist]
  Public = false
  access_token = ""
  auto_sync = {{ if $gistId }}true{{ else }}false{{ end }}
  file_name = "pet-snippet.toml"
  gist_id = {{ $gistId | quote }}

[GitLab]
  ID = ""
  Url = ""
  Visibility = "private"
  access_token = ""
  auto_sync = false
  file_name = "pet-snippet.toml"
  skip_ssl = false
